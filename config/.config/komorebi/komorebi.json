{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 7,
  "default_container_padding": 7,
  "transparency": true,
  "transparency_alpha": 250,
  "animation": {
    "enabled": true,
    "duration": 450,
    "fps": 120,
    "style": {
        "movement": "EaseOutExpo",
        "transparency": "Linear"
    }
  },
  "bar_configurations": [
    "$Env:USERPROFILE/.config/komorebi/komorebi.bar.json",
    "$Env:USERPROFILE/.config/komorebi/komorebi.bar.2.json"
  ],

  // "border": false,
  // "border_implementation": "Komorebi",
  // "border_offset": -1,
  
  "border_width": 3,
  "border_colours": {
    "single": "#11beb6",
    "stack": "#0dd3c9",
    "monocle": "#ff3399",
    "unfocused": "#2a3035"
  },
  "border_style": "Square",
  "mouse_follows_focus": false,
  "stackbar": {
    "mode": "Never" // never doesn't mean it's not on; just not showing within the wm
  },
  "floating_window_aspect_ratio": "Widescreen",
  "floating_applications": [
    {
      "kind": "Exe",
      "id": "explorer.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Motrix.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "ApplicationFrameHost.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "OneCommander.exe",
      "matching_strategy": "Equals"
    }
  ],
  "ignore_rules": [
    {
      "kind": "Exe",
      "id": "ShareX",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Arc extension popup",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Files.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "TeraCopy.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "SnippingTool.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Settings",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Microsoft Store",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "FileBot",
      "matching_strategy": "Equals"
    }
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "BSP"
        },
        {
          "name": "2",
          "layout": "BSP"
        },
        {
          "name": "3",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "^Code.exe$",
              "matching_strategy": "Regex"
            }
          ]
        },
        {
          "name": "4",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "RobloxPlayerBeta",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "destiny2",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "5",
          "layout": "VerticalStack"
        }
      ]
    },
    {
      "workspaces": [ 
        {
          "name": "1",
          "layout": "VerticalStack",
          "workspace_rules": [
            
          ]
        },
        {
          "name": "2",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "Steam",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Minecraft Launcher",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "EpicGamesLauncher",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Dolphin",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "3",
          "layout": "VerticalStack",
          "workspace_rules": [           
            {
              "kind": "Exe",
              "id": "LINE",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "4",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "qbittorrent",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Motrix",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "5",
          "layout": "VerticalStack",
          "workspace_rules": []
        }
      ]
    }
  ]
}
