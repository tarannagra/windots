{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.30/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Minimize",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 7,
  "default_container_padding": 7,
  "transparency": true,
  "transparency_alpha": 255,
  "animation": {
    "enabled": true,
    "duration": 300,
    "style": "EaseOutExpo",
    "fps": 165
  },
  "border": true,
  "border_width": 4,
  "border_implementation": "Windows",
  "border_offset": -1,
  "border_colours": {
    "single": "#ddd71f",
    "stack": "#00a542",
    "monocle": "#ff3399",
    "unfocused": "#2a3035"
  },
  "mouse_follows_focus": false,
  "stackbar": {
    "mode": "Never"    
  },
  "floating_applications": [
    {
      "kind": "Exe",
      "id": "explorer.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Motrix.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "ApplicationFrameHost.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "OneCommander.exe",
      "matching_strategy": "Equals"
    }
  ],
  "ignore_rules": [
    {
      "kind": "Exe",
      "id": "ShareX",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Arc extension popup",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Files.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "TeraCopy.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "SnippingTool.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Settings",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Microsoft Store",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "FileBot",
      "matching_strategy": "Equals"
    }
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "Home",
          "layout": "BSP"
        },
        {
          "name": "Interwebs",
          "layout": "BSP"
        },
        {
          "name": "Code",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "^Code.exe$",
              "matching_strategy": "Regex"
            }
          ]
        },
        {
          "name": "Game",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "RobloxPlayerBeta",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "destiny2",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Media",
          "layout": "VerticalStack"
        }
      ]
    },
    {
      "workspaces": [ 
        {
          "name": "Interwebs",
          "layout": "VerticalStack",
          "workspace_rules": [
            
          ]
        },
        {
          "name": "Game",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "Steam",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Minecraft Launcher",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "EpicGamesLauncher",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Dolphin",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Social",
          "layout": "VerticalStack",
          "workspace_rules": [           
            {
              "kind": "Exe",
              "id": "LINE",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Download",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "qbittorrent",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Motrix",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Media",
          "layout": "VerticalStack",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "MusicBee.exe",
              "matching_strategy": "Equals"
            }
          ]
        }
      ]
    }
  ]
}
